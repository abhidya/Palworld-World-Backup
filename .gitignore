# Staging area used while a snapshot is being verified. Never committed:
# it holds a half-copied world by design.
/.staging/

# Local-only working copies for save editing / MCP experiments.
/work/
/restore-staging/
/.secrets/
*.tmp
__pycache__/
.DS_Store

# Dashboard toolchain build outputs — the committed copies live in docs/.
/tools/dashboard/data.js
/tools/dashboard/trends.js
/tools/dashboard/*cache*.json
/tools/dashboard/.update.lock

# Third-party source, recreated at a pinned commit by
# tools/timelapse/bootstrap.sh. Not vendored and never a symlink: it is 78 MB
# of someone else's repository, and this one is a disaster-recovery copy of a
# world, not a dependency cache.
/tools/timelapse/extractors/cue4parse/
# Recreated by that same script from tools/timelapse/package.json.
/tools/timelapse/node_modules/
